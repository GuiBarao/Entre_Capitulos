# URL base da API do EntreCapitulos.
# Em desenvolvimento o Vite faz proxy de /api -> este endereço (evita CORS).
VITE_API_URL=http://localhost:3000

# (Opcional) Caminho base usado pelo cliente HTTP.
# Padrão: /api (passa pelo proxy do Vite). Defina a URL completa da API
# apenas se for consumir sem o proxy (ex.: build servido separadamente).
# VITE_API_BASE=/api
